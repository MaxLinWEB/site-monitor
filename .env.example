# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values, then `npm start`.
#
# Only monitor a site you OWN or are explicitly authorized to monitor.
# ---------------------------------------------------------------------------

# Target URL to monitor. Defaults to your local sandbox copy.
SITE_URL=http://localhost:5000

# How often to check, in milliseconds (30s).
CHECK_INTERVAL=30000

# Per-request timeout, in milliseconds (10s).
TIMEOUT=10000

# Smart failure detection: consecutive failures before OFFLINE,
# consecutive successes before ONLINE again.
FAILURES_TO_DOWN=3
SUCCESSES_TO_UP=2

# Telegram Bot API credentials (see README → "Telegram bot setup").
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional (defaults shown; uncomment to override) ---
# Daily heartbeat interval in ms (24h).
# HEARTBEAT_INTERVAL=86400000
# Where log files are written.
# LOG_DIR=logs
# Rotate the log once it passes this many bytes (5 MB).
# LOG_MAX_BYTES=5242880
# How many rotated log files to keep.
# LOG_MAX_FILES=5
# How many times to retry a failed Telegram send.
# TELEGRAM_RETRIES=3
# User-Agent sent with each check.
# USER_AGENT=site-monitor/1.0
# Telegram Bot API base URL. Override only for a self-hosted Bot API server
# or local testing; leave unset for the official API.
# TELEGRAM_API_BASE=https://api.telegram.org

# Status API port. On most hosts (Railway/Render/Fly) $PORT is injected
# automatically and the status API turns on by itself. Locally, set STATUS_PORT
# to expose GET /status and GET /health. Leave unset to disable it.
# STATUS_PORT=3000
